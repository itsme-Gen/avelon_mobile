# API Configuration
# For local development, use localhost
# For physical device testing, use your machine's local IP (find with: ipconfig on Windows or ifconfig on Mac/Linux)
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# Firebase Configuration (for push notifications)
# Get these values from Firebase Console → Project Settings → General → Your apps
# Shared across both platforms:
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# Android and iOS have different API keys:
EXPO_PUBLIC_FIREBASE_API_KEY_ANDROID=your_android_api_key
EXPO_PUBLIC_FIREBASE_API_KEY_IOS=your_ios_api_key
# Per-platform App IDs (register both Android and iOS apps in Firebase Console):
EXPO_PUBLIC_FIREBASE_APP_ID_ANDROID=1:000000000000:android:xxxxxxxxxxxxxx
EXPO_PUBLIC_FIREBASE_APP_ID_IOS=1:000000000000:ios:xxxxxxxxxxxxxx

# WalletConnect Configuration
# Get your project ID from https://cloud.walletconnect.com
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
EXPO_PUBLIC_EAS_PROJECT_ID=your_expo_eas_project_id

# Set to 31337 to target a local Hardhat node instead of Base Sepolia.
EXPO_PUBLIC_CHAIN_ID=
